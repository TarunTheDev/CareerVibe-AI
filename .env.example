# MongoDB (Get free MongoDB Atlas URL from: https://www.mongodb.com/cloud/atlas/register)
# Leave this as-is for now - MongoDB is optional, app will work without it
MONGO_URL=mongodb://localhost:27017
DB_NAME=careervibe

# AI provider
# The app works with local parsing/scoring when no external key is configured.
LLM_PROVIDER=local
AI_TIMEOUT_MS=15000
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
NEXT_PUBLIC_BASE_URL=

# Only enable this if your Emergent account has paid external access.
# LLM_PROVIDER=emergent
# LLM_API_KEY=

# ─── Real Job APIs ─────────────────────────────────────────────────────────────

# Adzuna Job API (https://developer.adzuna.com)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# LinkedIn Job Search API via RapidAPI
RAPIDAPI_KEY=your_rapidapi_key

# Findwork API (https://findwork.dev)
FINDWORK_KEY=your_findwork_key

# Apify LinkedIn Jobs Scraper
APIFY_KEY=your_apify_key

# Additional job providers used when keys/feed URLs are supplied
JOOBLE_API_KEY=
JSEARCH_API_KEY=
JSEARCH_RAPIDAPI_KEY=
JSEARCH_RAPIDAPI_HOST=jsearch.p.rapidapi.com
THEMUSE_API_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
CAREERJET_AFFILIATE_ID=
WHATJOBS_FEED_URL=
WHATJOBS_API_URL=
WHATJOBS_API_KEY=
ARBEITSAMT_API_KEY=jobboerse-jobsuche

# ─── Firebase Auth ──────────────────────────────────────────────────────────────
# Make sure these match EXACTLY what's in your Firebase Console → Project Settings
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id
NEXT_PUBLIC_GEMINI_SIDEBAR_KEY=your_gemini_api_key

# Groq (fast LLM — primary AI provider). Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
